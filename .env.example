# =============================================================================
# Nexmarket Admin (Empresa) — environment example
# =============================================================================
# The shared Firebase project config lives in firebase-applet-config.json (the
# SAME project used by loja, entregador and cliente). The variables below are
# OPTIONAL integration seams (RNF05) — the app degrades gracefully without them.

# Root super-admin email (bootstraps the very first operator). Mirrors the
# value baked into firestore.rules. Used only for client-side UX hints.
VITE_ROOT_ADMIN_EMAIL="caiosazeredo@cos.ufrj.br"

# Payment gateway (Split / estornos) — Stripe / Pagar.me / MercadoPago.
# Only PUBLIC keys belong on the client; refunds/splits must run server-side.
VITE_PAYMENTS_PROVIDER="stripe"
VITE_PAYMENTS_PUBLIC_KEY=""
# Server endpoint (Cloud Function / backend) that actually performs refunds and
# split payouts using the SECRET key. The panel calls this, never the PSP直接.
VITE_PAYMENTS_API_URL=""

# Background-check provider (CPF / Detran / antecedentes) for driver onboarding.
VITE_BACKGROUND_CHECK_API_URL=""

# Map tiles. Defaults to free OpenStreetMap; override for a keyed provider.
VITE_MAP_TILES_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
