# =============================================================================
# Nexmarket — Servidor de Pagamentos + Autenticação · copie para .env e preencha
# =============================================================================
# ⚠️ NUNCA commite o arquivo .env — a chave secreta dá acesso total à sua conta.

# --- Pagar.me v5 (Dashboard → Chaves de API) ----------------------------------
# Chave SECRETA (sk_test_... em teste, sk_live_... em produção) — usada só no
# servidor (Basic Auth nas chamadas REST).
PAGARME_SECRET_KEY=""
# Chave PÚBLICA (pk_test_...) — ecoada aos apps via GET /config, usada no
# client-side para tokenizar cartão (POST /core/v5/tokens?appId=...).
PAGARME_PUBLIC_KEY=""
# Segredo compartilhado do webhook — a Pagar.me não assina webhooks com HMAC
# publicamente documentado, então validamos via query string:
# https://SEU-SERVIDOR/api/webhooks/pagarme?key=SEU_SEGREDO
PAGARME_WEBHOOK_SECRET=""

# --- Firebase -----------------------------------------------------------------
# Projeto compartilhado pelos 4 apps (já é o padrão; altere se migrar de projeto)
FIREBASE_PROJECT_ID="gen-lang-client-0615772467"
FIRESTORE_DATABASE_ID="ai-studio-2ab80fc8-bdc4-40c4-9282-35669db98074"
# Service account (Console Firebase → Configurações → Contas de serviço →
# Gerar nova chave privada). Aceita o CAMINHO do .json ou o JSON inline.
# ⚠️ OBRIGATÓRIA para autenticação (login/registro de loja, empresa e
# entregador não funcionam sem ela — são elas que emitem os Custom Tokens e
# leem/escrevem staffCredentials/admins/users/drivers). Sem ela o servidor
# ainda sobe, mas todo /api/auth/* responde 500.
FIREBASE_SERVICE_ACCOUNT=""

# E-mail do super-admin (mesmo do firestore.rules)
ROOT_ADMIN_EMAIL="caiosazeredo@cos.ufrj.br"

# --- Servidor -----------------------------------------------------------------
PORT=8787
# URL pública deste servidor (usada em links de retorno/callbacks).
# Em produção: https://pagamentos.seudominio.com — em dev com túnel: URL do túnel.
PUBLIC_URL="http://localhost:8787"
# Origens liberadas no CORS (separadas por vírgula) — vazio libera todas.
ALLOWED_ORIGINS=""
CURRENCY="brl"

# Teto de valor de gorjeta (R$) e de auto-estorno de item pelo próprio cliente (R$).
MAX_TIP_BRL=200
SELF_REFUND_LIMIT_BRL=50
