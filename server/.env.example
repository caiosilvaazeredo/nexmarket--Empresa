# =============================================================================
# Nexmarket — Servidor de Pagamentos (Stripe) · copie para .env e preencha
# =============================================================================
# ⚠️ NUNCA commite o arquivo .env — a chave secreta dá acesso total à sua conta.

# --- Stripe (Dashboard → Developers → API keys) ------------------------------
# Chave SECRETA (sk_test_... em teste, sk_live_... em produção)
STRIPE_SECRET_KEY=""
# Chave PUBLICÁVEL (pk_test_...) — ecoada aos apps via GET /config
STRIPE_PUBLISHABLE_KEY="pk_test_51TmK35GozBghDYbFs8AHfPn29g7wt22Unn9fv7JA04hs2w9PgL7q8LiYMOjOvsPmksH6HDLICnXcraPeCH7wluM000Tjb69kDY"
# Segredo do webhook (Dashboard → Developers → Webhooks → Add endpoint
# apontando para https://SEU-SERVIDOR/api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=""

# --- Firebase -----------------------------------------------------------------
# Projeto compartilhado pelos 4 apps (já é o padrão; altere se migrar de projeto)
FIREBASE_PROJECT_ID="gen-lang-client-0615772467"
FIRESTORE_DATABASE_ID="ai-studio-2ab80fc8-bdc4-40c4-9282-35669db98074"
# Service account (Console Firebase → Configurações → Contas de serviço →
# Gerar nova chave privada). Aceita o CAMINHO do .json ou o JSON inline.
# Com ela o servidor valida valores no Firestore e marca pedidos pagos via
# webhook; sem ela o app cliente assume essa escrita (modo degradado).
FIREBASE_SERVICE_ACCOUNT=""

# E-mail do super-admin (mesmo do firestore.rules)
ROOT_ADMIN_EMAIL="caiosazeredo@cos.ufrj.br"

# --- Servidor -----------------------------------------------------------------
PORT=8787
# URL pública deste servidor (usada nos redirects do Stripe Checkout).
# Em produção: https://pagamentos.seudominio.com — em dev com túnel: URL do túnel.
PUBLIC_URL="http://localhost:8787"
# Origens liberadas no CORS (separadas por vírgula) — vazio libera todas.
ALLOWED_ORIGINS=""
CURRENCY="brl"
